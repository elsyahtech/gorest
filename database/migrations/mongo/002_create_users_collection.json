{
  "collection": "users",
  "validator": {
    "$jsonSchema": {
      "bsonType": "object",
      "required": [
        "id",
        "email",
        "password",
        "department_id",
        "is_active",
        "is_deleted",
        "created_at"
      ],
      "properties": {
        "id": { "bsonType": "string" },
        "email": { "bsonType": "string" },
        "password": { "bsonType": "string" },
        "department_id": { "bsonType": "string" },
        "is_active": { "bsonType": "bool" },
        "is_deleted": { "bsonType": "bool" },
        "created_at": { "bsonType": "date" },
        "updated_at": { "bsonType": ["date", "null"] },
        "deleted_at": { "bsonType": ["date", "null"] }
      }
    }
  },
  "indexes": [
    {
      "key": { "id": 1 },
      "name": "pk_users_id",
      "unique": true
    },
    {
      "key": { "email": 1 },
      "name": "uk_users_email",
      "unique": true
    }
  ]
}